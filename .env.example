# Copy this file to .env and fill in the values. Never commit .env.
# One line per key, in the form NAME=value (no spaces around =, no quotes).

# Slack - "OAuth & Permissions" page -> Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN=
# Slack - "Basic Information" page -> App-Level Tokens (starts with xapp-, scope connections:write)
SLACK_APP_TOKEN=
# The channel to watch (without #)
SLACK_CHANNEL_NAME=businesscard-scanner

# Attio - Workspace settings -> Developers -> New access token
ATTIO_API_KEY=

# Anthropic - console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Optional: country for phone numbers printed without a +country code (e.g. US, GB, IN)
DEFAULT_PHONE_COUNTRY=US
